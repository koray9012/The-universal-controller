    Serial.println("LoRa Radio Initialized!");
  } else {
    Serial.println("LoRa Initialization Failed!");
  }
  */
}

void loop() {
  // Read Triggers
  bool r2Pressed = (digitalRead(PIN_BTN_TR) == LOW); // Forward
  bool l2Pressed = (digitalRead(PIN_BTN_TL) == LOW); // Backward

  // Read Left Joystick VRx (GPIO 32)
  int lxRaw = analogRead(PIN_JOY_L_X);
  int deadzone = 800;
  int lx = lxRaw - 2048;

  bool steeringLeft = (lx < -deadzone);
  bool steeringRight = (lx > deadzone);

  // Simple string-based state construction
  String cmdStr = "STOP";

  if (r2Pressed && !l2Pressed) {
    if (steeringLeft) cmdStr = "FORWARD_LEFT";
    else if (steeringRight) cmdStr = "FORWARD_RIGHT";
    else cmdStr = "FORWARD";
  } 
  else if (l2Pressed && !r2Pressed) {
    if (steeringLeft) cmdStr = "BACK_LEFT";
    else if (steeringRight) cmdStr = "BACK_RIGHT";
    else cmdStr = "BACK";
  } 
  else if (steeringLeft) {
    cmdStr = "LEFT";
  } 
  else if (steeringRight) {
    cmdStr = "RIGHT";
  }

  cmdStr.toCharArray(outgoingCmd.cmd, sizeof(outgoingCmd.cmd));

  // Send simplified message over ESP-NOW
  esp_now_send(broadcastAddress, (uint8_t *)&outgoingCmd, sizeof(outgoingCmd));

  // --- OPTIONAL LORA BROADCAST (UNCOMMENT WHEN MODULE ADDED) ---
  /*
  LoRa.beginPacket();
  LoRa.write((uint8_t *)&outgoingCmd, sizeof(outgoingCmd));
  LoRa.endPacket();
  */

  if (millis() - lastResponseTime > 2000) {
    strcpy(robotName, "SEARCHING...");
  }

  // Display Status
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  
  display.setCursor(0, 0);
  display.println("CONNECTED TO:");

  display.setCursor(0, 14);
  display.println(robotName);

  display.setCursor(0, 32);
  display.print("CMD: ");
  display.println(outgoingCmd.cmd);

  display.setCursor(0, 48);
  display.print("ESP-NOW: ");
  display.println(espNowSuccess ? "LINK OK" : "NO LINK");

  display.display();

  delay(30);
}
