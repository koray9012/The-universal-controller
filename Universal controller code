// --- Server Route Handlers ---
void handleRoot() {
  server.send(200, "text/html", MAIN_PAGE);
}

String getTelemetryPayload() {
  String payload = "";
  payload += "Mode: " + String(currentMode) + " | WiFi Clients: " + String(WiFi.softAPgetStationNum()) + "<br>";
  payload += "GPS Sats: " + String(gps.satellites.value()) + " | Fix: " + String(gps.location.isValid() ? "YES" : "NO") + "<br>";
  payload += "Lat: " + String(gps.location.lat(), 6) + " | Lng: " + String(gps.location.lng(), 6) + "<br>";
  payload += "Solar Panel Angle: " + String(panelPos1) + "°<br>";
  payload += "Gimbal Pan: " + String(gimbalHPos) + "° Tilt: " + String(gimbalVPos) + "°<br>";
  payload += "LoRa Packet RSSI: " + String(LoRa.packetRssi());
  return payload;
}

void handleTelemetryRequest() {
  server.send(200, "text/plain", getTelemetryPayload());
}

void handleAction() {
  String cmd = server.arg("go");

  if (cmd == "forward") {
    digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
    digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
  } else if (cmd == "backward") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
    digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
  } else if (cmd == "left") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
    digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
  } else if (cmd == "right") {
    digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
  } else if (cmd == "stop") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
  } else if (cmd == "panel_up") {
    panelPos1 = min(180, panelPos1 + 15);
    panelPos2 = min(180, panelPos2 + 15);
    panelServo1.write(panelPos1);
    panelServo2.write(panelPos2);
  } else if (cmd == "panel_down") {
    panelPos1 = max(0, panelPos1 - 15);
    panelPos2 = max(0, panelPos2 - 15);
    panelServo1.write(panelPos1);
    panelServo2.write(panelPos2);
  } else if (cmd == "gimbal_left") {
    gimbalHPos = max(0, gimbalHPos - 15);
    gimbalHServo.write(gimbalHPos);
  } else if (cmd == "gimbal_right") {
    gimbalHPos = min(180, gimbalHPos + 15);
    gimbalHServo.write(gimbalHPos);
  }

  server.send(200, "text/plain", getTelemetryPayload());
}

// --- Setup Routine ---
void setup() {
  Serial.begin(115200);
  Serial2.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX); // GP-01 GPS Initialization

  // Pin Configurations
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);
  analogWrite(ENA, 220); // Default PWM throttle

  // Attach 4 Servos
  panelServo1.attach(SERVO_PANEL_1);
  panelServo2.attach(SERVO_PANEL_2);
  gimbalHServo.attach(SERVO_GIMBAL_H);
  gimbalVServo.attach(SERVO_GIMBAL_V);

  // Initial Servo Positions
  panelServo1.write(0);
  panelServo2.write(0);
  gimbalHServo.write(90);
  gimbalVServo.write(90);

  // OLED Display Initialization
  Wire.begin(21, 22);
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
  } else {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0,0);
    display.println(F("Mars Rover 2.0 Booting"));
    display.display();
  }

  // LoRa Transceiver Setup
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);
  if (!LoRa.begin(433E6)) {
    Serial.println("LoRa initialization failed!");
  } else {
    Serial.println("LoRa transceiver online!");
    LoRa.receive(); // Put LoRa into continuous listening mode
  }

  // Access Point Initialization
  WiFi.softAP("MarsRover-Enterprise", "12345678");
  server.on("/", handleRoot);
  server.on("/action", handleAction);
  server.on("/telemetry", handleTelemetryRequest);
  server.begin();
  
  Serial.println("Full Rover Systems Online & Operational!");
}

// --- Main Runtime Loop ---
void loop() {
  server.handleClient();

  // Stream incoming GPS characters into TinyGPS++ parser
  while (Serial2.available() > 0) {
    gps.encode(Serial2.read());
  }

  // Check for incoming LoRa telemetry packets asynchronously
  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    String incomingLoRaPacket = "";
    while (LoRa.available()) {
      incomingLoRaPacket += (char)LoRa.read();
    }
    Serial.print("Received LoRa Command: ");
    Serial.println(incomingLoRaPacket);
  }

  // Mode Switch Pushbutton Debounce & Execution Logic
  bool reading = digitalRead(BUTTON_PIN);
  if (reading == LOW && lastButtonState == HIGH && millis() - lastButtonPress > 300) {
    currentMode = (currentMode + 1) % 4;
    lastButtonPress = millis();
    
    // Audio Confirmation Beep
    digitalWrite(BUZZER_PIN, HIGH);
    delay(100);
    digitalWrite(BUZZER_PIN, LOW);
    
    Serial.print("Switched to Operation Mode: ");
    Serial.println(currentMode);
  }
  lastButtonState = reading;

  // Periodic OLED Dashboard Update
  if (millis() - previousTelemetryMillis >= telemetryInterval) {
    previousTelemetryMillis = millis();

    display.clearDisplay();
    display.setCursor(0, 0);
    display.print(F("Mode: ")); display.println(currentMode);
    display.print(F("Sats: ")); display.println(gps.satellites.value());
    display.print(F("Lat: ")); display.println(gps.location.lat(), 4);
    display.print(F("Lng: ")); display.println(gps.location.lng(), 4);
    display.print(F("Panel: ")); display.print(panelPos1); display.println(F(" deg"));
    display.display();
  }
}
}
