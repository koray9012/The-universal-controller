#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h>
#include <SPI.h>
#include <LoRa.h>
#include <TinyGPS++.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// --- System Pin Mapping & Configurations ---
#define ENA             14
#define IN1             27
#define IN2             26
#define IN3             25
#define IN4             33
#define BUTTON_PIN      4
#define BUZZER_PIN      19

// Servo Array Pins (4 Servos for Solar Panel Articulation & Gimbal Gimicks)
#define SERVO_PANEL_1   13
#define SERVO_PANEL_2   12
#define SERVO_GIMBAL_H  23
#define SERVO_GIMBAL_V  18

// GPS Module (GP-01 BDS+GPS) Hardware Serial 2
#define GPS_RX          16
#define GPS_TX          17

// LoRa SPI Bus Pin Mapping
#define LORA_SCK        5
#define LORA_MISO       19
#define LORA_MOSI       27
#define LORA_SS         18
#define LORA_RST        14
#define LORA_DIO0       26

// OLED Display Specs
#define SCREEN_WIDTH    128
#define SCREEN_HEIGHT   64
#define OLED_RESET      -1
#define SCREEN_ADDRESS  0x3C

// --- Global Objects ---
WebServer server(80);
TinyGPSPlus gps;
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

Servo panelServo1;
Servo panelServo2;
Servo gimbalHServo;
Servo gimbalVServo;

// --- State Machine & Telemetry Variables ---
int currentMode = 0; // 0: Auto, 1: Manual+Safety, 2: Suicide, 3: Diagnostics
unsigned long lastButtonPress = 0;
bool lastButtonState = HIGH;

int panelPos1 = 0;
int panelPos2 = 0;
int gimbalHPos = 90;
int gimbalVPos = 90;

unsigned long previousTelemetryMillis = 0;
const long telemetryInterval = 2000;

// --- Embedded Web Dashboard UI (Full HTML/CSS/JS Payload) ---
