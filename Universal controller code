// --- HARDWARE PINS ---
#define PIN_JOY_L_X  32  // Left Joystick Horizontal (Steering)
#define PIN_BTN_TL   4   // L2 Trigger (Drive Backward / Stop)
#define PIN_BTN_TR   13  // R2 Trigger (Drive Forward)
#define PIN_BTN_MODE 25  
#define PIN_BTN_MENU 27  

#define PIN_LED_TX   2   // Blue LED
#define PIN_LED_PWR  17  // Green LED
#define PIN_LED_DIAG 16  // White LED

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// --- ESP-NOW MESSAGES ---
struct CommandMessage {
  char cmd[16];
};

struct IdentityMessage {
  char name[32];
};

CommandMessage outgoingCmd;
IdentityMessage connectedRobot;

uint8_t broadcastAddress[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF};
bool espNowSuccess = false;
unsigned long lastResponseTime = 0;
char robotName[32] = "SEARCHING...";

void OnDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
  espNowSuccess = (status == ESP_NOW_SEND_SUCCESS);
  digitalWrite(PIN_LED_TX, espNowSuccess ? HIGH : LOW);
}

void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  if (len == sizeof(IdentityMessage)) {
    memcpy(&connectedRobot, incomingData, sizeof(connectedRobot));
    strncpy(robotName, connectedRobot.name, sizeof(robotName));
    lastResponseTime = millis();
  }
}

void setup() {
  Serial.begin(115200);

  pinMode(PIN_LED_TX, OUTPUT);
  pinMode(PIN_LED_PWR, OUTPUT);
  pinMode(PIN_LED_DIAG, OUTPUT);

  digitalWrite(PIN_LED_PWR, HIGH);

  pinMode(PIN_BTN_TL, INPUT_PULLUP);
  pinMode(PIN_BTN_TR, INPUT_PULLUP);
  pinMode(PIN_BTN_MODE, INPUT_PULLUP);
  pinMode(PIN_BTN_MENU, INPUT_PULLUP);

  Wire.begin(21, 22);
  if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0, 10);
    display.println("CONTROLLER READY");
    display.display();
  }

  WiFi.mode(WIFI_STA);
  if (esp_now_init() == ESP_OK) {
    esp_now_register_send_cb(OnDataSent);
    esp_now_register_recv_cb(OnDataRecv);

    esp_now_peer_info_t peerInfo = {};
    memcpy(peerInfo.peer_addr, broadcastAddress, 6);
    peerInfo.channel = 0;  
    peerInfo.encrypt = false;
    
    esp_now_add_peer(&peerInfo);
  }

  // --- LORA INITIALIZATION CODE (UNCOMMENT WHEN LORA MODULE ATTACHED) ---
