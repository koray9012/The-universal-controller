#include <WiFi.h>
#include <esp_now.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ==========================================
// 📶 NETWORK & RECEIVER TARGET CONFIG
// ==========================================
// Replace with the MAC Address of your target ESP32 Rover / Receiver
uint8_t receiverMac[] = {0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF}; 

// ==========================================
// 📌 PIN DEFINITIONS
// ==========================================
#define PIN_JOY_L_X   32
#define PIN_JOY_L_Y   33
#define PIN_JOY_R_X   34
#define PIN_JOY_R_Y   35

#define PIN_BTN_L2    4   // Fire Gel Blaster / Primary Trigger
#define PIN_BTN_R2    13  // Alt Trigger / Special Action
#define PIN_BTN_MODE  25  // Mode Switch (Auto / Manual Safe / Suicide / Diag)
#define PIN_BTN_MENU  27  // Menu / Telemetry Toggle

#define PIN_LED_TX    2   // Blue TX Status LED
#define PIN_LED_PWR   17  // Green Power/Link LED
#define PIN_LED_DIAG  16  // White Diagnostic LED

#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 64
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// ==========================================
// 📦 ESP-NOW PACKET STRUCTURES
// ==========================================
// Primary Universal Controller Packet Structure
typedef struct ControllerPacket {
  int16_t joyLX;
  int16_t joyLY;
  int16_t joyRX;
  int16_t joyRY;
  bool btnL2;         // Gel Blaster Firing Command
  bool btnR2;
  uint8_t driveMode;  // 0: Auto, 1: Manual+Safe, 2: Suicide, 3: Diag
  uint32_t timestamp;
} ControllerPacket;

ControllerPacket txData;

// Secondary Glove Mouse Structure (for protocol bridging/emulation)
typedef struct GlovePacket {
  int speedLeft;     // -255 to 255
  int speedRight;    // -255 to 255
  bool lmb;          // Gel Blaster trigger equivalent
  bool rmb;
  bool mmb;
  bool isFrozen;     
} GlovePacket;

GlovePacket gloveData;

// Telemetry ACK struct received back from vehicle
typedef struct TelemetryPacket {
  char robotName[32];
  uint8_t batteryPercent;
  bool linkAlive;
} TelemetryPacket;

TelemetryPacket rxTelemetry;

// ==========================================
// ⚙️ GLOBALS & STATES
// ==========================================
bool screenOK = false;
bool linkActive = false;
unsigned long lastAckTime = 0;
unsigned long lastTxTime = 0;
unsigned long lastBtnPress = 0;

uint8_t currentMode = 1; // Default: Manual + Safety
bool firingActive = false;

// --- ESP-NOW CALLBACKS ---
void OnDataSent(const uint8_t *mac_addr, esp_now_send_status_t status) {
  if (status == ESP_OK) {
    digitalWrite(PIN_LED_TX, HIGH);
    lastAckTime = millis();
    linkActive = true;
  } else {
    digitalWrite(PIN_LED_TX, LOW);
  }
}

void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  if (len == sizeof(TelemetryPacket)) {
    memcpy(&rxTelemetry, incomingData, sizeof(rxTelemetry));
    lastAckTime = millis();
    linkActive = true;
  }
}

// ==========================================
// 🖥️ UI & TELEMETRY DISPLAY
// ==========================================
void updateDisplay() {
  if (!screenOK) return;

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  // Top Header: Link Status & Active Protocol Mode
  display.setCursor(0, 0);
  display.print("LINK: ");
  display.print(linkActive ? "[ONLINE]" : "[OFFLINE]");

  display.setCursor(80, 0);
  if (currentMode == 0) display.print("AUTO");
  else if (currentMode == 1) display.print("SAFE");
  else if (currentMode == 2) display.print("SUICIDE");
  else display.print("DIAG");

  display.drawLine(0, 10, 128, 10, SSD1306_WHITE);

  // Gel Blaster Firing Warning Bar
  if (firingActive) {
    display.fillRect(0, 14, 128, 14, SSD1306_WHITE);
    display.setTextColor(SSD1306_BLACK);
    display.setCursor(12, 17);
    display.print("!!! FIRING BLASTER !!!");
    display.setTextColor(SSD1306_WHITE);
  } else {
    display.setCursor(0, 17);
    display.print("Target: ");
    display.print(rxTelemetry.robotName[0] != '\0' ? rxTelemetry.robotName : "Rover AP");
  }

  // Joystick Input Visualizers
  display.setCursor(0, 36);
  display.print("L Stick: "); display.print(txData.joyLX); display.print(","); display.print(txData.joyLY);

  display.setCursor(0, 48);
  display.print("R Stick: "); display.print(txData.joyRX); display.print(","); display.print(txData.joyRY);

  // Bottom Status Bar
  int signalWidth = linkActive ? 124 : 0;
  display.drawRect(0, 58, 128, 6, SSD1306_WHITE);
  display.fillRect(2, 60, signalWidth, 2, SSD1306_WHITE);

  display.display();
}

// ==========================================
// 🛠️ SETUP
// ==========================================
void setup() {
  Serial.begin(115200);

  // Setup Switches and Triggers
  pinMode(PIN_BTN_L2, INPUT_PULLUP);
  pinMode(PIN_BTN_R2, INPUT_PULLUP);
  pinMode(PIN_BTN_MODE, INPUT_PULLUP);
  pinMode(PIN_BTN_MENU, INPUT_PULLUP);

  // Setup Indicator LEDs
  pinMode(PIN_LED_TX, OUTPUT);
  pinMode(PIN_LED_PWR, OUTPUT);
  pinMode(PIN_LED_DIAG, OUTPUT);

  digitalWrite(PIN_LED_PWR, HIGH); // Power Indicator ON

  // Setup Display
  Wire.begin(21, 22);
  if (display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    screenOK = true;
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(10, 20);
    display.println("UNIVERSAL CTRL");
    display.setCursor(10, 35);
    display.println("BOOTING ESP-NOW...");
    display.display();
    delay(500);
  }

  // Setup Wi-Fi for Peer-to-Peer ESP-NOW
  WiFi.mode(WIFI_STA);

  if (esp_now_init() == ESP_OK) {
    esp_now_register_send_cb(OnDataSent);
    esp_now_register_recv_cb(OnDataRecv);

    // Register Target Vehicle Peer
    esp_now_peer_info_t peerInfo = {};
    memcpy(peerInfo.peer_addr, receiverMac, 6);
    peerInfo.channel = 0;
    peerInfo.encrypt = false;
    esp_now_add_peer(&peerInfo);
  }
}

// ==========================================
// 🔄 MAIN LOOP
// ==========================================
void loop() {
  unsigned long now = millis();

  // Mode Toggle Debounce
  if (digitalWrite(PIN_BTN_MODE) == LOW && (now - lastBtnPress > 300)) {
    lastBtnPress = now;
    currentMode = (currentMode + 1) % 4;
  }

  // Read Analog Joysticks
  txData.joyLX = analogRead(PIN_JOY_L_X) - 2048; // Center normalized
  txData.joyLY = analogRead(PIN_JOY_L_Y) - 2048;
  txData.joyRX = analogRead(PIN_JOY_R_X) - 2048;
  txData.joyRY = analogRead(PIN_JOY_R_Y) - 2048;

  // Read Triggers (Gel Blaster Firing Logic)
  txData.btnL2 = (digitalRead(PIN_BTN_L2) == LOW);
  txData.btnR2 = (digitalRead(PIN_BTN_R2) == LOW);
  txData.driveMode = currentMode;
  txData.timestamp = now;

  firingActive = txData.btnL2;

  // Populate Glove Emulation Data Struct for Cross-Compatibility Mode
  gloveData.speedLeft = map(txData.joyLY + txData.joyLX, -2048, 2048, -255, 255);
  gloveData.speedRight = map(txData.joyLY - txData.joyLX, -2048, 2048, -255, 255);
  gloveData.lmb = txData.btnL2; // Trigger maps to left mouse click
  gloveData.rmb = txData.btnR2;
  gloveData.isFrozen = (currentMode == 3); // Diagnostics mode pauses motion

  // Transmit Control Frame via ESP-NOW at 50Hz (Every 20ms)
  if (now - lastTxTime >= 20) {
    lastTxTime = now;
    esp_now_send(receiverMac, (uint8_t *)&txData, sizeof(txData));
  }

  // Turn off TX LED pulse
  if (now - lastTxTime > 10) {
    digitalWrite(PIN_LED_TX, LOW);
  }

  // Check Link Timeout Fail-safe (500ms heartbeat drop)
  if (now - lastAckTime > 500) {
    linkActive = false;
    digitalWrite(PIN_LED_PWR, (now / 250) % 2 == 0 ? HIGH : LOW); // Blink Power LED on link loss
  } else {
    digitalWrite(PIN_LED_PWR, HIGH);
  }

  // Update Diagnostic / Telemetry Display
  updateDisplay();

  delay(5);
}
}
